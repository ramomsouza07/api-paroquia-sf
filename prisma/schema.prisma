generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id        String   @id @default(uuid()) @db.Uuid
  nome      String   @db.VarChar(150)
  email     String   @unique @db.VarChar(150)
  senhaHash String   @map("senha_hash")
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  artigos Artigo[]

  @@map("admins")
}

model Artigo {
  id             String    @id @default(uuid()) @db.Uuid
  titulo         String    @db.VarChar(250)
  slug           String    @unique @db.VarChar(250)
  resumo         String?   @db.VarChar(500)
  conteudo       String
  imagemCapa     String?   @map("imagem_capa")
  categoria      String    @default("Noticias") @db.VarChar(100)
  publicado      Boolean   @default(false)
  autorId        String?   @map("autor_id") @db.Uuid
  autor          Admin?    @relation(fields: [autorId], references: [id], onDelete: SetNull)
  dataPublicacao DateTime? @map("data_publicacao") @db.Timestamptz(6)
  criadoEm       DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@index([slug])
  @@index([publicado, dataPublicacao])
  @@map("artigos")
}
